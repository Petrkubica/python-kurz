import pickle

countries = {}

def add_country():
    country = input("Zadejte název země: ")
    capital = input("Zadejte hlavní město: ")
    countries[country] = capital
    print(f"Přidáno: {country} - {capital}")

def delete_country():
    country = input("Zadejte název země k odstranění: ")
    if country in countries:
        del countries[country]
        print(f"Země {country} byla odstraněna.")
    else:
        print("Země nebyla nalezena.")

def search_country():
    country = input("Zadejte název země k vyhledání: ")
    print(countries.get(country, "Země nebyla nalezena."))

def edit_country():
    country = input("Zadejte název země k úpravě: ")
    if country in countries:
        new_capital = input("Zadejte nové hlavní město: ")
        countries[country] = new_capital
        print(f"Aktualizováno: {country} - {new_capital}")
    else:
        print("Země nebyla nalezena.")

def save_data():
    with open("countries.pkl", "wb") as f:
        pickle.dump(countries, f)
    print("Data byla uložena.")

def load_data():
    global countries
    try:
        with open("countries.pkl", "rb") as f:
            countries = pickle.load(f)
        print("Data byla načtena.")
    except FileNotFoundError:
        print("Soubor s daty nebyl nalezen.")

while True:
    print("\n1. Přidat zemi")
    print("2. Smazat zemi")
    print("3. Vyhledat zemi")
    print("4. Upravit zemi")
    print("5. Uložit data")
    print("6. Načíst data")
    print("7. Ukončit")
    
    choice = input("Vyberte akci (1-7): ")
    
    if choice == "1":
        add_country()
    elif choice == "2":
        delete_country()
    elif choice == "3":
        search_country()
    elif choice == "4":
        edit_country()
    elif choice == "5":
        save_data()
    elif choice == "6":
        load_data()
    elif choice == "7":
        break
    else:
        print("Neplatná volba.")

print("Program ukončen.")


